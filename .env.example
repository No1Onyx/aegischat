# Copy to .env and adjust for your deployment.

# ---- Client (Vite build-time) ----
# The relay the web/desktop client connects to. Must be reachable from the
# browser. Use https:// / wss is derived automatically.
VITE_RELAY_URL=http://localhost:4000

# ---- Relay server (runtime) ----
# Port the relay listens on.
PORT=4000
# Comma-separated list of browser origins allowed to call the relay.
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,https://tauri.localhost

# ---- Node test harness ----
# Overrides the relay URL for `npm run test:*`.
AEGIS_RELAY_URL=http://localhost:4000
